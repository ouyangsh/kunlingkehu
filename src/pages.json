{
  "globalStyle": {
    "navigationStyle": "default",
    "navigationBarTitleText": "unibest",
    "navigationBarBackgroundColor": "#f8f8f8",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#FFFFFF",
    "h5": {}
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^uv-(.*)": "@climblee/uv-ui/components/uv-$1/uv-$1.vue",
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "type": "home",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "首页",
        "disableScroll": true
      }
    },
    {
      "path": "pages/group/detail",
      "type": "page",
      "style": {
        "navigationBarTitleText": "群组签到"
      }
    },
    {
      "path": "pages/group/join",
      "type": "page",
      "style": {
        "navigationBarTitleText": "加入签到群组"
      }
    },
    {
      "path": "pages/group/list",
      "type": "page",
      "style": {
        "navigationBarTitleText": "我的签到群组"
      }
    },
    {
      "path": "pages/index/manage",
      "type": "page",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "消息"
      }
    },
    {
      "path": "pages/index/messages",
      "type": "page",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "消息",
        "backgroundColor": "#fff"
      }
    },
    {
      "path": "pages/login/index",
      "type": "page",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "邮箱登录",
        "backgroundColor": "#fffcfc",
        "backgroundColorBottom": "#fffcfc",
        "backgroundColorTop": "#fffcfc",
        "disableScroll": true
      }
    }
  ],
  "subPackages": []
}
